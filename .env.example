# Copy to .env for local work. On Netlify set these in Site settings → Environment variables.
# NEVER commit real values.

# From @BotFather (/newbot)
BOT_TOKEN=123456:ABC...
# Any long random string (letters/digits/_-). Telegram sends it back with every update.
WEBHOOK_SECRET=change-me-long-random
# Any long random string. Opens https://YOUR-SITE.netlify.app/setup?key=THIS
SETUP_SECRET=change-me-another-long-random
# Neon → Connection string (pooled, host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon → Connection string with "Connection pooling" OFF (used for migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Your Telegram numeric id (ask @userinfobot). Several: comma separated.
OWNER_TELEGRAM_IDS=123456789
# Optional: real road distances for route optimisation. Free key at https://openrouteservice.org
# (sign up → Dashboard → Tokens). Without it, straight-line distance × 1.3 is used ("taxminiy").
ORS_API_KEY=
